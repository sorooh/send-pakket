{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements-prod.txt"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && python manage.py collectstatic --noinput && gunicorn sendpakket.wsgi:application --bind 0.0.0.0:$PORT --workers 4 --threads 4",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "DEBUG": "False",
        "SECRET_KEY": "${{ RAILWAY_PROJECT_SECRET_KEY }}",
        "DATABASE_URL": "${{ RAILWAY_PROJECT_DATABASE_URL }}",
        "REDIS_URL": "${{ RAILWAY_PROJECT_REDIS_URL }}",
        "ALLOWED_HOSTS": "${{ RAILWAY_PROJECT_DOMAIN }}",
        "CORS_ALLOWED_ORIGINS": "https://${{ RAILWAY_PROJECT_DOMAIN }}",
        "EMAIL_HOST": "smtp.gmail.com",
        "EMAIL_PORT": "587",
        "EMAIL_USE_TLS": "True"
      }
    }
  }
}